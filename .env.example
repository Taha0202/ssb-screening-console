# ==============================================================================
# SIH26188 — Smart Border Document Verification & Screening Platform
# Deployment & Environment Configuration
# ==============================================================================

# Application Profile
ENV_PROFILE=development
AI_INFERENCE_MODE="LOCAL / OFFLINE"
PIPELINE_VERSION="2.0.0"
OFFLINE_MODE=true

# Database Configuration (Profile A: SQLite Offline | Profile B: PostgreSQL Enterprise)
DATABASE_URL=sqlite:///./data/sih_screening.db
# DATABASE_URL=postgresql://postgres:postgres@db:5432/sih_screening

# Security & Session Authentication
SECRET_KEY=sih_2026_ssb_secure_dev_key_super_secret_offline_token
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Network & CORS Settings
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:80,http://127.0.0.1:5173

# Local File & Biometrics Storage
MAX_UPLOAD_SIZE_MB=15
DUPLICATE_FACE_THRESHOLD=75.0
FACE_MATCH_THRESHOLD=70.0
TAMPERING_THRESHOLD=50.0
